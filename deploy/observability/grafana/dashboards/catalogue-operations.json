{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "links": [
    { "title": "Open catalogue operations", "type": "link", "url": "http://localhost:5175/ops", "targetBlank": true }
  ],
  "panels": [
    {
      "type": "row", "title": "Freshness", "id": 1, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "Source overdue seconds", "id": 2,
      "description": "Source label identifies the operator page entry.",
      "links": [{ "title": "Sources", "url": "http://localhost:5175/ops/sources", "targetBlank": true }],
      "targets": [
        { "expr": "catalogue_source_overdue_seconds", "legendFormat": "{{source}} overdue", "refId": "A" },
        { "expr": "1 - catalogue_source_success_state", "legendFormat": "{{source}} never succeeded", "refId": "B" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "type": "timeseries", "title": "Latest records and ratio", "id": 3,
      "description": "Latest usable complete result; legends name the source.",
      "links": [{ "title": "Sources", "url": "http://localhost:5175/ops/sources", "targetBlank": true }],
      "targets": [
        { "expr": "catalogue_source_records", "legendFormat": "{{source}} records", "refId": "A" },
        { "expr": "catalogue_source_record_ratio", "legendFormat": "{{source}} ratio", "refId": "B" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "type": "row", "title": "Work", "id": 4, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "Jobs by state", "id": 5,
      "links": [{ "title": "Runs", "url": "http://localhost:5175/ops/runs", "targetBlank": true }],
      "targets": [
        { "expr": "catalogue_jobs", "legendFormat": "{{state}} current", "refId": "A" },
        { "expr": "sum by (outcome) (rate(catalogue_jobs_completed_total[5m]))", "legendFormat": "{{outcome}} completions/s", "refId": "B" }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 }
    },
    {
      "type": "timeseries", "title": "Oldest queued job", "id": 6,
      "links": [{ "title": "Operations", "url": "http://localhost:5175/ops", "targetBlank": true }],
      "targets": [{ "expr": "catalogue_queue_oldest_age_seconds", "legendFormat": "seconds", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 }
    },
    {
      "type": "timeseries", "title": "Worker capacity", "id": 7,
      "links": [{ "title": "Workers", "url": "http://localhost:5175/ops", "targetBlank": true }],
      "targets": [{ "expr": "catalogue_workers", "legendFormat": "{{health}}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 }
    },
    {
      "type": "timeseries", "title": "Job duration", "id": 14,
      "description": "Terminal job wall time grouped by bounded outcome.",
      "links": [{ "title": "Runs", "url": "http://localhost:5175/ops/runs", "targetBlank": true }],
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(catalogue_job_duration_seconds_bucket[1h])))", "legendFormat": "{{outcome}} p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(catalogue_job_duration_seconds_bucket[1h])))", "legendFormat": "{{outcome}} p95", "refId": "B" }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 }
    },
    {
      "type": "row", "title": "Upstreams", "id": 8, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "Upstream request outcomes", "id": 9,
      "description": "Legends identify bounded source, host, and outcome labels.",
      "links": [{ "title": "Sources", "url": "http://localhost:5175/ops/sources", "targetBlank": true }],
      "targets": [
        { "expr": "sum by (source, host, outcome) (rate(catalogue_requests_total[5m]))", "legendFormat": "{{source}} {{host}} {{outcome}}", "refId": "A" },
        { "expr": "sum(rate(catalogue_cache_total{outcome=\"hit\"}[5m])) / clamp_min(sum(rate(catalogue_cache_total{outcome=~\"hit|miss\"}[5m])), 0.000001)", "legendFormat": "cache hit ratio", "refId": "B" },
        { "expr": "sum by (source) (rate(catalogue_browser_renders_total[5m]))", "legendFormat": "{{source}} browser renders/s", "refId": "C" },
        { "expr": "sum by (host, status) (rate(catalogue_http_errors_total[5m]))", "legendFormat": "{{host}} HTTP {{status}}/s", "refId": "D" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "type": "timeseries", "title": "Upstream latency and throttling", "id": 10,
      "description": "Host is the bounded upstream identifier.",
      "links": [{ "title": "Sources", "url": "http://localhost:5175/ops/sources", "targetBlank": true }],
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, host) (rate(catalogue_request_duration_seconds_bucket[5m])))", "legendFormat": "{{host}} p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, host) (rate(catalogue_request_duration_seconds_bucket[5m])))", "legendFormat": "{{host}} p95", "refId": "B" },
        { "expr": "histogram_quantile(0.95, sum by (le, host) (rate(catalogue_host_backoff_seconds_bucket[5m])))", "legendFormat": "{{host}} backoff p95", "refId": "C" },
        { "expr": "sum by (host) (rate(catalogue_host_lease_contended_total[5m]))", "legendFormat": "{{host}} lease waits/s", "refId": "D" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    },
    {
      "type": "row", "title": "Services", "id": 11, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false
    },
    {
      "type": "timeseries", "title": "API request and 5xx rate", "id": 12,
      "description": "Legends identify service and route template; no concrete paths or request IDs.",
      "links": [{ "title": "Operations", "url": "http://localhost:5175/ops", "targetBlank": true }],
      "targets": [
        { "expr": "sum by (service, route) (rate(catalogue_http_requests_total[5m]))", "legendFormat": "{{service}} {{route}} all", "refId": "A" },
        { "expr": "sum by (service, route) (rate(catalogue_http_requests_total{status_class=\"5xx\"}[5m]))", "legendFormat": "{{service}} {{route}} 5xx", "refId": "B" },
        { "expr": "catalogue_http_requests_in_flight", "legendFormat": "{{service}} in flight", "refId": "C" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 }
    },
    {
      "type": "timeseries", "title": "API p95 latency and scrape health", "id": 13,
      "description": "Service/route and scrape instance remain visible in the legend.",
      "links": [{ "title": "Operations", "url": "http://localhost:5175/ops", "targetBlank": true }],
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, service, route) (rate(catalogue_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}} {{route}} p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, service, route) (rate(catalogue_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{service}} {{route}} p95", "refId": "B" },
        { "expr": "up{job=~\"catalogue-.*\"}", "legendFormat": "{{job}} {{instance}} up", "refId": "C" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["catalogue", "operations"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Catalogue operations",
  "uid": "catalogue-operations",
  "version": 1
}
