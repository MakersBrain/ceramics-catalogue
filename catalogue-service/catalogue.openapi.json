{
  "components": {
    "schemas": {
      "BatchResponse": {
        "properties": {
          "products": {
            "items": {
              "$ref": "#/components/schemas/CanonicalProductDetail"
            },
            "title": "Products",
            "type": "array"
          }
        },
        "required": [
          "products"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "CanonicalProduct": {
        "description": "One product as a search result: enough to decide whether it is the thing.",
        "properties": {
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Brand"
          },
          "canonical_name": {
            "title": "Canonical Name",
            "type": "string"
          },
          "canonical_product_id": {
            "title": "Canonical Product Id",
            "type": "string"
          },
          "family": {
            "anyOf": [
              {
                "enum": [
                  "glaze",
                  "underglaze",
                  "engobe",
                  "clay_body",
                  "oxide",
                  "stain",
                  "raw_material",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Family"
          },
          "firing_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FiringRange"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "manufacturer_sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Manufacturer Sku"
          },
          "price": {
            "$ref": "#/components/schemas/PriceSummary"
          },
          "source_count": {
            "description": "How many shops carry it.",
            "title": "Source Count",
            "type": "integer"
          }
        },
        "required": [
          "canonical_product_id",
          "canonical_name",
          "source_count",
          "price"
        ],
        "title": "CanonicalProduct",
        "type": "object"
      },
      "CanonicalProductDetail": {
        "properties": {
          "brand": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Brand"
          },
          "canonical_name": {
            "title": "Canonical Name",
            "type": "string"
          },
          "canonical_product_id": {
            "title": "Canonical Product Id",
            "type": "string"
          },
          "family": {
            "anyOf": [
              {
                "enum": [
                  "glaze",
                  "underglaze",
                  "engobe",
                  "clay_body",
                  "oxide",
                  "stain",
                  "raw_material",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Family"
          },
          "firing_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FiringRange"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "manufacturer_sku": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Manufacturer Sku"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/Offer"
            },
            "title": "Offers",
            "type": "array"
          }
        },
        "required": [
          "canonical_product_id",
          "canonical_name"
        ],
        "title": "CanonicalProductDetail",
        "type": "object"
      },
      "FiringRange": {
        "description": "What a product's own text says about firing, never inferred.",
        "properties": {
          "cone_max": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cone Max"
          },
          "cone_min": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cone Min"
          },
          "cone_system": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cone System"
          },
          "max_celsius": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Celsius"
          },
          "min_celsius": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Celsius"
          },
          "published_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Published Unit"
          }
        },
        "title": "FiringRange",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Manufacturer": {
        "properties": {
          "homepage_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Homepage Url"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "product_count": {
            "title": "Product Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "product_count"
        ],
        "title": "Manufacturer",
        "type": "object"
      },
      "ManufacturersResponse": {
        "properties": {
          "manufacturers": {
            "items": {
              "$ref": "#/components/schemas/Manufacturer"
            },
            "title": "Manufacturers",
            "type": "array"
          }
        },
        "required": [
          "manufacturers"
        ],
        "title": "ManufacturersResponse",
        "type": "object"
      },
      "Offer": {
        "description": "One shop's listing of one product.",
        "properties": {
          "availability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Availability"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "When this price was collected. A consumer cannot otherwise tell a price from this morning from one from March.",
            "title": "Observed At"
          },
          "package_quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Package Quantity"
          },
          "package_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Package Unit"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Price"
          },
          "product_url": {
            "title": "Product Url",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "supplier_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Supplier Name"
          },
          "supplier_reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Supplier Reference"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit Price"
          },
          "unit_price_per": {
            "anyOf": [
              {
                "enum": [
                  "l",
                  "kg"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unit Price Per"
          },
          "vat_status": {
            "anyOf": [
              {
                "enum": [
                  "inclusive",
                  "exclusive",
                  "unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Vat Status"
          }
        },
        "required": [
          "source_id",
          "product_url"
        ],
        "title": "Offer",
        "type": "object"
      },
      "PriceSummary": {
        "description": "A price range across the shops that carry a product.\n\nAlways in `currency` at `rate_date`. The old API returned a bare number\nmixing EUR, USD and GBP, which made a \"cheapest per litre\" comparison\nquietly wrong for any product carried in more than one country.",
        "properties": {
          "currency": {
            "const": "EUR",
            "default": "EUR",
            "title": "Currency",
            "type": "string"
          },
          "max_per_kilogram": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Per Kilogram"
          },
          "max_per_litre": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Per Litre"
          },
          "min_per_kilogram": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Per Kilogram"
          },
          "min_per_litre": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Per Litre"
          },
          "rate_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The date of the reference rates used to convert other currencies.",
            "title": "Rate Date"
          }
        },
        "title": "PriceSummary",
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 `application/problem+json`.\n\nOne error schema referenced from every operation, in place of an\nundocumented `{\"error\": \"...\"}` string that each client had to guess at.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Pass as `cursor` to continue. Absent when there is no more.",
            "title": "Next Cursor"
          },
          "products": {
            "items": {
              "$ref": "#/components/schemas/CanonicalProduct"
            },
            "title": "Products",
            "type": "array"
          }
        },
        "required": [
          "products"
        ],
        "title": "SearchResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Cross-tenant reference data for ceramic materials: glazes, underglazes, engobes,\nclay bodies, oxides and raw materials, collected from public supplier\ncatalogues and grouped into canonical products.\n\nRead-only, and that is a contract rather than a convention — the build asserts\nthis document contains no operation other than `get`. Nothing a consumer does\ncan change what another consumer sees.\n\nPrices are converted to EUR at a stated reference rate; every offer carries the\ndate its price was collected.",
    "title": "Ceramics catalogue",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Liveness, and whether the database is reachable"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Liveness, and whether the database is reachable",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/canonical-products": {
      "get": {
        "description": "Aggregates only: the number of shops carrying each product and its price range. Offers are not included, because a search that returned every pack of every result would be answering a question nobody asked — fetch one product, or a batch, for those.\n\nOrdered by how many shops carry a product, then brand and code: a code eleven shops sell is more likely the one somebody means.",
        "operationId": "searchCanonicalProducts",
        "parameters": [
          {
            "description": "Free text over name, brand and code.",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Restrict to one manufacturer id.",
            "in": "query",
            "name": "manufacturer",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Restrict to one product family.",
            "in": "query",
            "name": "family",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Results per page, capped at 200.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Continue from a previous page's `next_cursor`. The old API capped `limit` and returned no cursor, so there was no way to read past the cap at all.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Search canonical products"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Search canonical products",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/v1/canonical-products/{id}": {
      "get": {
        "operationId": "getCanonicalProduct",
        "parameters": [
          {
            "description": "A canonical product uuid.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanonicalProductDetail"
                }
              }
            },
            "description": "One canonical product, with every shop's offer"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "One canonical product, with every shop's offer",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/v1/canonical-products:batch": {
      "get": {
        "description": "The batch form of the operation above, for a client that has a list of ids and wants one round trip rather than fifty.",
        "operationId": "batchCanonicalProducts",
        "parameters": [
          {
            "description": "Comma-separated canonical product uuids, at most 200.",
            "in": "query",
            "name": "ids",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            },
            "description": "Several canonical products, with their offers"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Several canonical products, with their offers",
        "tags": [
          "catalogue"
        ]
      }
    },
    "/v1/manufacturers": {
      "get": {
        "operationId": "listManufacturers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManufacturersResponse"
                }
              }
            },
            "description": "Manufacturers with at least one active product"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Manufacturers with at least one active product",
        "tags": [
          "catalogue"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "the service itself",
      "url": "/"
    }
  ]
}
