# Copy to .env. Nothing here is a real secret; the production values come from
# Infisical through scripts/infisical-populate.sh.

# -- database ----------------------------------------------------------------
CATALOGUE_DB_NAME=ateliera
CATALOGUE_DB_USER=catalogue
CATALOGUE_DB_PASSWORD=catalogue
# Loopback only. 5434 keeps it clear of the application stack on 5433 and of any
# system PostgreSQL on 5432.
CATALOGUE_DB_PORT=5434

# -- control plane -----------------------------------------------------------
# Required. catalogue-control refuses to start without it, and compose refuses
# to render without it, because an unauthenticated service that can cancel runs
# and disable sources is worse than not having one.
#
#   openssl rand -hex 32
CATALOGUE_CONTROL_TOKEN=

# -- explorer ----------------------------------------------------------------
CATALOGUE_UI_PORT=5175

# -- tracing (optional) ------------------------------------------------------
# The SDK is always wired; spans are only exported when this is set. There is no
# collector in the deployment yet, which is why it is empty: what ships today is
# the trace_id on each job row and in every log line, so the correlation exists
# in the data and a collector added later reads history rather than starting
# from zero.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
